# --- mail-ops internal dashboard ---
# See lib/mail-ops/README.md for full setup instructions.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Must have the Gmail API enabled and these scopes configured on the consent
# screen: gmail.readonly, gmail.send, openid, email, profile.
MAIL_OPS_GOOGLE_CLIENT_ID=
MAIL_OPS_GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret used to encrypt the session cookie/JWT.
# Generate with: openssl rand -base64 32
MAIL_OPS_AUTH_SECRET=

# The only Google account allowed to sign in to the dashboard.
MAIL_OPS_ADMIN_EMAIL=democratiseresearch@gmail.com

# Optional: enables AI categorization/summary of incoming mail via Claude.
# Falls back to keyword-based categorization if unset.
MAIL_OPS_ANTHROPIC_API_KEY=

# Optional: default Gmail search query the dashboard loads on open.
MAIL_OPS_DEFAULT_QUERY="aisehack OR hackathon"

# Required by NextAuth v5 for callback URL construction outside of Vercel's
# auto-detection (set this to your deployed origin, e.g. https://aisehack.example.com).
AUTH_URL=
