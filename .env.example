# --- mail-ops internal dashboard ---
# See lib/mail-ops/README.md for full setup instructions.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Must have the Gmail API enabled and these scopes configured on the consent
# screen: gmail.readonly, gmail.send, openid, email, profile.
MAIL_OPS_GOOGLE_CLIENT_ID=
MAIL_OPS_GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret used to encrypt the session cookie/JWT.
# Generate with: openssl rand -base64 32
MAIL_OPS_AUTH_SECRET=

# The only Google account allowed to sign in to the dashboard.
MAIL_OPS_ADMIN_EMAIL=democratiseresearch@gmail.com

# Optional: enables AI categorization/summary of incoming mail via Gemini.
# Falls back to keyword-based categorization if unset.
MAIL_OPS_GEMINI_API_KEY=

# Optional: default Gmail search query the dashboard loads on open.
MAIL_OPS_DEFAULT_QUERY="aisehack OR hackathon"

# Auth.js's own basePath (defaults to /api/auth) must line up with this
# site's Next.js basePath (/aisehack, see next.config.ts) or redirects
# after login will be built with the wrong path. Set the FULL path:
#   production: https://precog.iiit.ac.in/aisehack/api/auth
#   local dev:  http://localhost:3000/api/auth   (dev basePath is empty)
AUTH_URL=


# --- kaggle-ops leaderboard analysis ---
# See lib/kaggle-ops/README.md for full setup instructions.

# kaggle.com → your avatar → Settings → API → "Create New Token".
# Downloads kaggle.json: {"username": "...", "key": "..."} — paste both here.
# NOTE: creating a new token invalidates any previous one.
# The account must have joined and accepted the rules for all four
# competitions; the API mirrors web permissions exactly.
KAGGLE_OPS_USERNAME=
KAGGLE_OPS_KEY=

# Optional tuning.
KAGGLE_OPS_CACHE_TTL_MS=600000
KAGGLE_OPS_TOP_N=20
KAGGLE_OPS_TIER_GAP_MULTIPLIER=2.5

# The leaderboard API does not expose metric direction, so it is assumed
# higher-is-better. Set to "true" for a track whose metric is an error
# measure (RMSE/MAE) where lower is better. The app also infers direction
# from the API's own row ordering and warns when the two disagree.
KAGGLE_OPS_POLYMER_LOWER_IS_BETTER=
KAGGLE_OPS_SAR_LOWER_IS_BETTER=
